  68:Common/Src/hcsr04.c **** void hcsr04_trigger_all(void)
  69:Common/Src/hcsr04.c **** {
  70:Common/Src/hcsr04.c ****     for (uint8_t i = 0; i < HCSR04_NUM_SENSORS; i++)
  71:Common/Src/hcsr04.c ****         hcsr04_trigger(i);
  72:Common/Src/hcsr04.c **** }
