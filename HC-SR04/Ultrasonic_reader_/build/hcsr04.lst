  50:Common/Src/hcsr04.c **** void hcsr04_trigger(uint8_t sensor)
  51:Common/Src/hcsr04.c **** {
  52:Common/Src/hcsr04.c ****     if (sensor >= HCSR04_NUM_SENSORS) return;
  53:Common/Src/hcsr04.c ****     hcsr04_sensor_t *s = &hcsr04_sensors[sensor];
  54:Common/Src/hcsr04.c **** 
  55:Common/Src/hcsr04.c ****     s->captured  = 0;
  56:Common/Src/hcsr04.c ****     s->measuring = 1;
  57:Common/Src/hcsr04.c ****     s->status    = HCSR04_OK;
  58:Common/Src/hcsr04.c **** 
  59:Common/Src/hcsr04.c ****     HAL_GPIO_WritePin(s->trig_port, s->trig_pin, GPIO_PIN_SET);
  60:Common/Src/hcsr04.c ****     uint32_t start = DWT->CYCCNT;
  61:Common/Src/hcsr04.c ****     uint32_t ticks = (HAL_RCC_GetHCLKFreq() / 1000000U) * 10;
  62:Common/Src/hcsr04.c ****     while ((DWT->CYCCNT - start) < ticks);
  63:Common/Src/hcsr04.c ****     HAL_GPIO_WritePin(s->trig_port, s->trig_pin, GPIO_PIN_RESET);
  64:Common/Src/hcsr04.c **** }
